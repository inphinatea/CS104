    {
      "cell_type": "code",
      "source": [
        "# General Variables\n",
        "names = []\n",
        "grades = []\n",
        "number = int(input(\"Enter Number of Students: \"))\n",
        "sum = 0\n",
        "\n",
        "for i in range(number):\n",
        "  # Takes Inputs for Names and Grades\n",
        "  names.append(input(\"Enter Name Here: \"))\n",
        "  grades.append(input(\"Enter Grade Here: \"))\n",
        "\n",
        "with open(\"grade_report.txt\", \"w\") as f:\n",
        "  for i in range(number):\n",
        "    # Finds the Spacing for the Name\n",
        "    space = (10 - len(names[i])) * \" \"\n",
        "    f.write(f\"{names[i]}: {space} {grades[i]}\\n\")\n",
        "    sum += float(grades[i])\n",
        "  # Writes the Average Grade to the File\n",
        "  f.write(f\"Average Grade: {float(sum / number):.2f}\")\n",
        "  average = float(sum / number)\n",
        "  # Converts the Grade Number into a Letter\n",
        "  if average >= 90:\n",
        "    letter_average = \"A\"\n",
        "  elif average >= 80:\n",
        "    letter_average = \"B\"\n",
        "  elif average >= 70:\n",
        "    letter_average = \"C\"\n",
        "  elif average >= 60:\n",
        "    letter_average = \"D\"\n",
        "  else:\n",
        "    letter_average = \"F\"\n",
        "  f.write(f\"\\nAverage Letter Grade: {letter_average}\")\n",
        "\n",
        "print(\"File grade_report.txt is made\")"
      ],
      "metadata": {
